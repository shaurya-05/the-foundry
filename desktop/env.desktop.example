# FOUND3RY desktop env — copy to `.env.desktop` next to FOUND3RY.exe
# when installing outside the monorepo. Do not commit real secrets.
#
# Phase 2b defaults (zero Docker):
DATABASE_BACKEND=sqlite
CACHE_BACKEND=memory
GRAPH_BACKEND=none
CELERY_ENABLED=0
# SQLITE_DB_PATH=C:\path\to\foundry_desktop.db

# Phase 6c — allowlisted system actions (open Notepad/Calculator/Explorer/browser,
# lock screen, open URL). Desktop buildBackendEnv defaults this to "1".
# Set to 0 to disable registration of the system_action tool entirely.
# Never enable this on found3ry.com / docker-compose — it is desktop-only.
# ENABLE_SYSTEM_ACTIONS=1

JWT_SECRET_LOCAL_PROD=
ADMIN_PASSWORD_LOCAL_PROD=

# Phase 4 — cloud BYOK (bring-your-own-key). Leave unset/commented for the
# default local-Ollama path. When set to "anthropic", the desktop setup UI
# also writes USE_LOCAL_*=0 and supplies ANTHROPIC_API_KEY from encrypted
# storage (desktop/data/), not from this file.
# CLOUD_BYOK_PROVIDER=anthropic
# ANTHROPIC_API_KEY=  # prefer the setup UI / safeStorage blob over plaintext here

# Only needed if you override DATABASE_BACKEND=postgres:
# POSTGRES_PASSWORD_LOCAL_PROD=
# DATABASE_URL=postgresql://foundry:CHANGEME@127.0.0.1:5433/foundry_db
# REDIS_URL=redis://127.0.0.1:6380
