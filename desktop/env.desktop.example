# FOUND3RY desktop (Phase 1) — copy to `.env.desktop` next to FOUND3RY.exe
# when installing outside the monorepo. Values mirror docker-compose.local-prod
# host ports (Postgres 5433, Redis 6380). Do not commit real secrets.

# Either set DATABASE_URL directly, or set POSTGRES_PASSWORD_LOCAL_PROD and
# the app will build postgresql://foundry:...@127.0.0.1:5433/foundry_db
POSTGRES_PASSWORD_LOCAL_PROD=
JWT_SECRET_LOCAL_PROD=
ADMIN_PASSWORD_LOCAL_PROD=

# Optional overrides:
# DATABASE_URL=postgresql://foundry:CHANGEME@127.0.0.1:5433/foundry_db
# REDIS_URL=redis://127.0.0.1:6380
# DESKTOP_BACKEND_PORT=8000
# DESKTOP_FRONTEND_PORT=3000
