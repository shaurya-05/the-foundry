# FOUND3RY desktop env — copy to `.env.desktop` next to FOUND3RY.exe
# when installing outside the monorepo. Do not commit real secrets.
#
# Phase 2b defaults (zero Docker):
DATABASE_BACKEND=sqlite
CACHE_BACKEND=memory
GRAPH_BACKEND=none
CELERY_ENABLED=0
# SQLITE_DB_PATH=C:\path\to\foundry_desktop.db

JWT_SECRET_LOCAL_PROD=
ADMIN_PASSWORD_LOCAL_PROD=

# Only needed if you override DATABASE_BACKEND=postgres:
# POSTGRES_PASSWORD_LOCAL_PROD=
# DATABASE_URL=postgresql://foundry:CHANGEME@127.0.0.1:5433/foundry_db
# REDIS_URL=redis://127.0.0.1:6380
