{
  "name": "found3ry-desktop",
  "version": "0.1.2",
  "private": true,
  "description": "FOUND3RY Phase 1 desktop packaging shell (Electron + local FastAPI/Next sidecars)",
  "main": "main.js",
  "author": "FOUND3RY",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "prepare:resources": "node scripts/prepare-resources.mjs",
    "build:frontend": "node scripts/prepare-resources.mjs --build-only",
    "pack": "node scripts/prepare-resources.mjs && electron-builder --dir",
    "dist": "node scripts/prepare-resources.mjs && electron-builder --win nsis --publish never",
    "dist:dir": "node scripts/prepare-resources.mjs && electron-builder --win --dir --publish never",
    "dist:noside": "electron-builder --win nsis --publish never",
    "dist:mac": "node scripts/prepare-resources.mjs && electron-builder --mac --publish never",
    "dist:mac:noside": "electron-builder --mac --publish never"
  },
  "build": {
    "appId": "com.found3ry.desktop",
    "productName": "FOUND3RY",
    "copyright": "Copyright © FOUND3RY",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "preload-main.js",
      "lib/**/*",
      "setup/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/frontend",
        "to": "frontend"
      },
      {
        "from": "resources/backend",
        "to": "backend"
      },
      {
        "from": "resources/python",
        "to": "python",
        "filter": [
          "**/*"
        ]
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "shaurya-05",
        "repo": "the-foundry"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "FOUND3RY-Setup-${version}.${ext}",
      "signAndEditExecutable": false
    },
    "mac": {
      "target": [
        {
          "target": "dmg"
        },
        {
          "target": "zip"
        }
      ],
      "category": "public.app-category.productivity",
      "artifactName": "FOUND3RY-${version}.${ext}",
      "identity": null,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "FOUND3RY uses your microphone for voice input to H3RO (push-to-talk and the always-listening wake word)."
      }
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "FOUND3RY"
    },
    "asar": true
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  }
}
